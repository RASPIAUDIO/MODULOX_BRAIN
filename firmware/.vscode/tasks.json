{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Modulox: compiler (mise à jour ensuite depuis l’éditeur)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/idf.ps1", "build"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Modulox: compiler",
