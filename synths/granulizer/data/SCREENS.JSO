{
  "screens": [
    {
	  "group": "Grain",
      "name": "Sample select",
      "title": "Set sample",
      "background": "bg_waveform",
	  "window": "wave",
      "controllers": [
        {
          "type": "list",
          "id": "sample_select",
          "text": "Select sample",
          "unit": "",
          "min": 0,
          "max": 16,
          "x": 15,
          "y": 160,
		  "ext": "WAV"
        },
        {
          "type": "encoder",
          "id": "sample_start",
          "text": "Start",
          "unit": "",
          "min": 0,
          "max": 127,
          "x": 150,
          "y": 160
        },
        {
          "type": "encoder",
          "id": "sample_end",
          "text": "End",
          "unit": "",
          "min": 0,
          "max": 127,
          "x": 220,
          "y": 160
        }
      ]
    },
    {
